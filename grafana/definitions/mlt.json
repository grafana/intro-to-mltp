      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Error Percentages by Target",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "mimir"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "(sum by (url_path)(increase(traces_spanmetrics_calls_total{status_code=\"STATUS_CODE_ERROR\",url_path=~\"${httpEndpoint}\",service_version=~\"${serviceVersion}\"}[5m])))/(sum by (url_path)(increase(traces_spanmetrics_calls_total{status_code!=\"\",url_path=~\"${httpEndpoint}\",service_version=~\"${serviceVersion}\"}[5m]))) * 100",
                        "instant": false,
                        "interval": "",
                        "legendFormat": "{{url_path}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "10.2.0-133752",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "textMode": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 5,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  },
                  "links": [
                    {
                      "targetBlank": true,
                      "title": "Traces for Erroring Endpoint",
                      "url": "/explore?orgId=1&left={\"datasource\":\"tempo\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"tempo\",\"uid\":\"tempo\"},\"queryType\":\"traceql\",\"limit\":20,\"query\":\"{ span%2Eurl%2Epath = \\\"${__field.labels.url_path}\\\" %26%26 status = error }\"}],\"range\":{\"from\":\"now-1h\",\"to\":\"now\"}}"
